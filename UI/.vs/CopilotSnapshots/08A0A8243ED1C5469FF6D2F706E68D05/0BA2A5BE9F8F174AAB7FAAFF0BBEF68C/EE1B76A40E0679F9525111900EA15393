using System;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

namespace SecureGate
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // Carga la imagen "modulos.png" desde la carpeta de la aplicación si existe
            string imgPath = Path.Combine(Application.StartupPath, "modulos.png");

            var pictureBoxModulos = new PictureBox();
            pictureBoxModulos.Name = "pictureBoxModulos";
            pictureBoxModulos.SizeMode = PictureBoxSizeMode.Zoom;
            pictureBoxModulos.Dock = DockStyle.Fill;

            if (File.Exists(imgPath))
            {
                try
                {
                    pictureBoxModulos.Image = Image.FromFile(imgPath);
                }
                catch
                {
                    // Ignorar error de carga de imagen por ahora
                }
            }

            // Añadir al formulario (se mostrará ocupando todo el área cliente)
            this.Controls.Add(pictureBoxModulos);
        }
    }
}
